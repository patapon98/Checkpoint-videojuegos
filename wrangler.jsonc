{
  // Configuración de despliegue de Final Secreto en Cloudflare Workers.
  // El "name" debe coincidir con el nombre del Worker en el panel de Cloudflare.
  "name": "finalsecreto",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": true,
  "build": {
    "command": "node scripts/build-cloudflare-preview.mjs"
  },
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
